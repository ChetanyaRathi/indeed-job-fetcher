# Local model server (Ollama by default; LM Studio uses http://localhost:1234/v1)
LLM_ENDPOINT=http://localhost:11434/v1
LLM_MODEL=qwen3.5:9b
EMBED_MODEL=nomic-embed-text

# Matching thresholds
TOP_K=10
MIN_FIT=80
# Adzuna jobs redirect to external ATS forms, so keep this false or all
# results get dropped.
EASY_APPLY_ONLY=false

# Server behavior
MAX_CONCURRENT_LLM=1
JOB_REFRESH_HOURS=6
MAX_UPLOAD_MB=5
DATA_DIR=data

# Adzuna job feed (free API key: https://developer.adzuna.com/)
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key
ADZUNA_COUNTRY=us
ADZUNA_TARGET_COUNT=150
